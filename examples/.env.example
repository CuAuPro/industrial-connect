# Environment-only connector examples: these examples do not load application YAML.
# Only required connection fields and credentials are shown; defaults are omitted.
# For applications with YAML (such as IPE), keep addresses/TLS/paths there instead.
# Copy only the section you need. Never commit actual credentials.

ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=appuser
ORACLE_PASSWORD=change-me

PGHOST=localhost
PGDATABASE=industrial
PGUSER=appuser
PGPASSWORD=change-me

MSSQL_SERVER=localhost
MSSQL_DATABASE=industrial
MSSQL_USER=appuser
MSSQL_PASSWORD=change-me

QUESTDB_CONF="wss::addr=questdb.example:9000;auto_flush=off;"

# MQTT defaults to TLS on port 8883.
MQTT_HOST=broker.example
# MQTT_USERNAME=reader
# MQTT_PASSWORD=change-me

# OPC UA generates client files under data/opcua/default/ by default.
# Set OPCUA_NAME=datacol1 to use data/opcua/datacol1/ instead.
# Provision this trusted server certificate separately.
OPCUA_ENDPOINT=opc.tcp://opcua.example:4840
OPCUA_SERVER_CERTIFICATE=data/opcua/trusted-server.der
# OPCUA_USERNAME=reader
# OPCUA_PASSWORD=change-me
