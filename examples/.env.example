# Sample values only. Config.from_env() reads only the fields of its own config class.
# Prefix + uppercase field name; optional empty fields become None.
SQLITE_DATABASE=store.db
SQLITE_TIMEOUT=10

ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=appuser
ORACLE_PASSWORD=change-me
ORACLE_POOL=true

PGHOST=localhost
PGPORT=5432
PGDATABASE=industrial
PGUSER=appuser
PGPASSWORD=change-me
PGPOOL=true
PGSSLMODE=verify-full
PGSSLROOTCERT=

MSSQL_SERVER=localhost
MSSQL_DATABASE=industrial
MSSQL_USER=appuser
MSSQL_PASSWORD=change-me

QUESTDB_CONF="wss::addr=questdb.example:9000;auto_flush=off;"

MQTT_HOST=broker.example
# Optional stable ID; omit to generate a unique ID per config.
# MQTT_CLIENT_ID=equipment-collector-1
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_FILE=
# Optional Paho QoS 1/2 window and outgoing queue limit; 0 means unlimited.
# MQTT_MAX_INFLIGHT_MESSAGES=1000
# MQTT_MAX_QUEUED_MESSAGES=20000

OPCUA_ENDPOINT=opc.tcp://opcua.example:4840
OPCUA_APPLICATION_URI=urn:industrial-connect:example
OPCUA_USERNAME=
OPCUA_PASSWORD=
OPCUA_CERTIFICATE=data/opcua/client.der
OPCUA_PRIVATE_KEY=data/opcua/client-key.pem
OPCUA_SERVER_CERTIFICATE=data/opcua/trusted-server.der
OPCUA_AUTO_GENERATE_CERTIFICATE=true
OPCUA_FORCE_CERTIFICATE_REGENERATION=false
